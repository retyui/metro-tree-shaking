    "picomatch": "^4.0.2"
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.88.1",
    "@react-native/metro-babel-transformer": "0.88.1",
    "jest": "^30.0.0",
    "metro": "0.87.3",
    "metro-config": "0.87.3",
    "metro-minify-terser": "0.87.3"
  },
  "jest": {
